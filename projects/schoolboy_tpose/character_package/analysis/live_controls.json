  "adapter_design": {
    "summary": "Live input -> normalise to the control's value_range -> response curve -> rig target",
    "stages": [
      {
        "stage": "input",
        "detail": "Moho 14.5 Live Mode camera/gamepad input (identifier from discovery)"
      },
      {
        "stage": "normalise",
        "detail": "map the input's native range onto value_range; clamp"
      },
      {
        "stage": "curve",
        "detail": "deadzone, gain, smoothing, optional inversion (e.g. 'mouth closing')"
      },
      {
        "stage": "target",
        "detail": "smart_bone: control angle = lerp(min_deg, max_deg, value); action: trigger/weight by value; bone_rotation: degrees"
      }
    ],
    "implementation_status": "design only - requires verified Moho input identifiers (LM-1)"
  }
