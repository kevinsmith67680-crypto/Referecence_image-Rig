{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autorig.live_controls-1.0.0",
  "title": "AutoRig Studio live_controls 1.0.0",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "spec_version",
    "controls",
    "moho_showtime",
    "adapter_design"
  ],
  "properties": {
    "schema": {
      "const": "autorig.live_controls"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "spec_version": {
      "const": "1.0.0"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "value_range",
          "neutral",
          "animation_target_type",
          "artwork_dependencies",
          "missing_artwork",
          "readiness",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value_range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "neutral": {
            "type": "number"
          },
          "animation_target_type": {
            "enum": [
              "smart_bone",
              "action",
              "bone_rotation",
              "switch_layer"
            ]
          },
          "artwork_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_artwork": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "readiness": {
            "enum": [
              "READY",
              "REQUIRES_RECONSTRUCTION",
              "REQUIRES_NEW_ARTWORK",
              "UNSUPPORTED",
              "NEEDS_REVIEW"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "minItems": 20
    },
    "moho_showtime": {
      "type": "object",
      "required": [
        "verified_mappings",
        "proposed_mappings",
        "verification_status"
      ],
      "properties": {
        "verified_mappings": {
          "type": "array"
        },
        "proposed_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control",
              "device",
              "status"
            ],
            "properties": {
              "status": {
                "const": "proposed_unverified"
              }
            }
          }
        }
      }
    },
    "adapter_design": {
      "type": "object",
      "required": [
        "stages",
        "implementation_status"
      ]
    }
  }
}
