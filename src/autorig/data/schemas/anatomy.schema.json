{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autorig.anatomy-1.0.0",
  "title": "AutoRig Studio anatomy 1.0.0",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "image",
    "side_convention",
    "joints",
    "bones",
    "parts",
    "occlusion",
    "validation",
    "segmentation",
    "estimators"
  ],
  "properties": {
    "schema": {
      "const": "autorig.anatomy"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "image": {
      "type": "object",
      "required": [
        "width",
        "height",
        "coordinate_system",
        "source_sha256"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "coordinate_system": {
          "const": "pixels; origin top-left; +x right; +y down"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "side_convention": {
      "type": "string"
    },
    "facing_assumption": {
      "enum": [
        "front"
      ]
    },
    "midline_x": {
      "type": "number"
    },
    "joints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "position",
          "confidence",
          "reliable",
          "method",
          "flags",
          "occluded_by",
          "visible",
          "parent"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reliable": {
            "type": "boolean"
          },
          "method": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "occluded_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visible": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minProperties": 20
    },
    "bones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from",
          "to",
          "length_px"
        ],
        "properties": {
          "length_px": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "pixels",
          "bbox_xyxy",
          "empty",
          "method",
          "mask",
          "pivot"
        ],
        "properties": {
          "pixels": {
            "type": "integer",
            "minimum": 0
          },
          "bbox_xyxy": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "empty": {
            "type": "boolean"
          },
          "pivot": {
            "type": "object",
            "required": [
              "position",
              "joint",
              "status"
            ]
          }
        }
      }
    },
    "occlusion": {
      "type": "object",
      "required": [
        "joints_occluded",
        "instance_overlaps"
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "issues",
        "unreliable_joints"
      ]
    },
    "segmentation": {
      "type": "object",
      "required": [
        "accepted_instances",
        "rejected_instances",
        "run"
      ]
    },
    "estimators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
