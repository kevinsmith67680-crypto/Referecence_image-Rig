{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autorig.joint_preparation-1.0.0",
  "title": "AutoRig Studio joint_preparation 1.0.0",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "joints"
  ],
  "properties": {
    "schema": {
      "const": "autorig.joint_preparation"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "joints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "pivot",
          "pivot_reliable",
          "child_components",
          "overlap_padding_px",
          "sweep",
          "safe_range_deg",
          "recommended_binding",
          "status"
        ],
        "properties": {
          "pivot": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "recommended_binding": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "minProperties": 13
    },
    "notes": {
      "type": "array"
    }
  }
}
