      {"bone": "forearm",   "channel": "rotation_offset_deg", "keys": [{"frame": 1, "value": 0}, {"frame": 10, "value": 45}, {"frame": 19, "value": 15}, {"frame": 28, "value": 45}, {"frame": 36, "value": 0}]}
